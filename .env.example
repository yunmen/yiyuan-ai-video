# ==================================
# docker compose 环境变量模板(数据库/Redis 密码等敏感值)
# 用法:复制为项目根目录 .env 后填写;.env 已被 .gitignore 忽略,禁止入库。
# 注意:各值需与 backend/env/.env.<环境>、worker/env/.env.<环境> 中同名配置保持一致。
# ==================================

# PostgreSQL 容器(与 backend 的 POSTGRESQL_* 保持一致)
POSTGRES_DB = "grapefruit"
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = ""

# Redis 认证密码(与 backend / worker 的 REDIS_PASSWORD 保持一致)
REDIS_PASSWORD = ""
