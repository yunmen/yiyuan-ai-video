# Caddy 配置(替代原 devops/nginx/conf/scui.conf)
# 移动端 H5 + 管理后台 SPA + 反代后端
# 【人工配置】站点地址:本地/内网用 :80;有域名后改为域名(如 yiyuan.91fengqun.com),Caddy 会自动签发 HTTPS
:80 {
	# 后端上传上限为 50MB(backend/app/routes/user/common.py),网关需放宽到 50MB 以上
	request_body {
		max_size 60MB
	}

	# 响应压缩(zstd 优先,gzip 兜底),对静态资源与反代接口同时生效,显著降低跨洋传输体积
	encode zstd gzip

	# 后端接口(前端基址为 /api/user 与 /api/admin,原样转发,不重写路径)
	# Caddy 的 reverse_proxy 默认透传 Host 并自动附加 X-Forwarded-For / X-Forwarded-Proto
	handle /api/* {
		reverse_proxy backend:8801
	}

	# 后端静态资源(用户上传素材、生成结果等)
	handle /static/* {
		reverse_proxy backend:8801
	}

	# 接口文档(Swagger / ReDoc / 蓝鲸 UI,均由 backend 提供;页面内静态资源走上面的 /static/*)
	# 注意:文档为公网可见,如需保护可在此加 basic_auth
	@api_docs path /docs /redoc /ljdoc /openapi.json
	handle @api_docs {
		reverse_proxy backend:8801
	}

	# 管理后台(admin,构建基址为 /admin/,产物放在 data/admin/)
	redir /admin /admin/ 308
	handle_path /admin/* {
		# 带 hash 的构建产物:命中不到就交回 404,绝不回落 index.html。
		# 若回落,浏览器会把 HTML 当 JS 解析并报语法错误,难以定位;404 才是真实语义。
		handle /assets/* {
			root * /usr/share/caddy/admin
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# 其余(index.html/配置/SPA 路由):每次回源校验,缺失时回落 index.html
		handle {
			root * /usr/share/caddy/admin
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	# admin 源码内写死的绝对路径静态资源(public/img、public/code、public/tinymce),
	# desktop 未使用这些路径,直接映射到 admin 产物目录
	@admin_public path /img/* /code/* /tinymce/*
	handle @admin_public {
		root * /usr/share/caddy/admin
		# 公共静态资源(图片/tinymce 等)不带 hash,但内容稳定,缓存 7 天减少跨洋重复请求
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# 移动端 H5 单页应用(mobile 构建产物:data/mobile)
	# 带 hash 的产物缺失时返回 404,不回落 index.html(理由同 admin)
	handle /assets/* {
		root * /usr/share/caddy/mobile
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /usr/share/caddy/mobile
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log
	}
}
