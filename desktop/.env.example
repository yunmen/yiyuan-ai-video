# desktop 生产构建环境变量示例(复制为 .env.production 后按实际环境填写)
# 说明见 src/config/index.js:生产环境 API_URL = VITE_APP_API_BASEURL || "/api"

# 后端对外地址,**必须以 /api/user 结尾**。
# 后端接口实际挂载为 /api/user/v1/...;若此处缺 /user 段,所有请求会 404。
# 例:backend 部署在 https://api.example.com 时,此处填 https://api.example.com/api/user
VITE_APP_API_BASEURL=https://your-backend-domain/api/user

# 是否走 Vite 代理(仅本地开发用,生产构建务必为 false 或留空)
VITE_APP_PROXY=false

# 站点标题(可选)
VITE_APP_TITLE=AI 成片
