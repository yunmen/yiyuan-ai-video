# ====================== worker 环境配置模板 ======================
# 用法:复制为 .env.dev / .env.test / .env.prod 后填写(这些文件已被 .gitignore 忽略)
ENVIRONMENT=dev

# ====================== Redis / ARQ ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_NAME=0
REDIS_USER=default
REDIS_PASSWORD=
ARQ_QUEUE_NAME=generate
# 并发消费上限(ARQ max_jobs):任务多为 I/O 等待(模型轮询),可适当调高;
# 宿主机核数少时注意收尾阶段多路 ffmpeg 的 CPU/内存占用
ARQ_CONCURRENCY=20
ARQ_JOB_TIMEOUT=3600
ARQ_MAX_RETRIES=3
ARQ_RETRY_DELAY=10
# 任务结果保留时长(秒):backend 需同步 await 结果(如 ai_recognize),需覆盖等待时长
ARQ_KEEP_RESULT=600

# ====================== 生成进度 ======================
GEN_PROGRESS_INTERVAL=5

# ====================== 回调 backend ======================
# 需与 backend WORKER_CALLBACK_SECRET 一致
NOTIFY_URL=http://localhost:8801/api/user/v1/task/callback
NOTIFY_TOKEN=dev-callback-secret   # 需与 backend WORKER_CALLBACK_SECRET 一致;prod 必须改为真实值

# ====================== 拉取 backend 业务配置(热更新)======================
# 【人工配置·必填】worker 周期拉取 backend 的 gen.* 配置(模型名/网关地址密钥)用。
# 容器部署填服务名(如 http://backend:8801);留空则回退代码默认 127.0.0.1:8801,
# 在容器内指向自身 → 拉取必然失败 → 管理端改模型/网关不生效(任务回退 env 默认值)。
BACKEND_PUBLIC_URL=http://localhost:8801
# 配置热更新轮询间隔(秒,最小 15)
CONFIG_REFRESH_INTERVAL=60

# ====================== 大模型(真实接入) ======================
# 【人工配置】OpenAI 兼容网关地址与密钥
LLM_BASE_API_URL=
LLM_BASE_API_KEY=
# 【人工配置】各类型模型 ID
CHAT_MODEL=qwen3.7-max
TEXT_MODEL=qwen3.7-max
IMAGE_MODEL=qwen-image-2.0
IMAGE_MODEL_EDIT=
VIDEO_MODEL=happyhorse-1.1-t2v
AUDIO_MODEL=qwen-audio-3.0-tts-plus
MUSIC_MODEL=fun-music-v1

IMAGE_RATIO=1:1
VIDEO_MODEL_T2V=happyhorse-1.1-t2v
VIDEO_MODEL_I2V=happyhorse-1.1-i2v
VIDEO_MODEL_R2V=happyhorse-1.1-r2v
VIDEO_RATIO=16:9
VIDEO_RESOLUTION=720P
VIDEO_POLL_INTERVAL=10
VIDEO_POLL_TIMEOUT=3300
AUDIO_VOICE=alloy
AUDIO_FORMAT=mp3

# 数字人口播(形象图 + 口播音频 → 口型驱动视频)
# 留空表示未接入该能力:数字人任务会以明确原因失败,不会静默产出错误结果。
# 通常由管理端「业务配置」gen.digital_model 下发覆盖(优先级:DB > env)。
DIGITAL_MODEL=

# ====================== 对象存储(腾讯云 COS) ======================
OSS_ENABLE=false
# 【人工配置】OSS_ENABLE=true 时必填
OSS_SERVICE_SecretId=
OSS_SERVICE_SecretKey=
OSS_SERVICE_Bucket=
OSS_SERVICE_Region=ap-chengdu
OSS_SERVICE_Accelerate=false
