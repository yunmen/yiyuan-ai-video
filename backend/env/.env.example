# ==================================
# 后端环境配置模板
# 用法:复制为 .env.dev / .env.test / .env.prod 后填写(这些文件已被 .gitignore 忽略)
# ==================================

ENVIRONMENT = "dev"

# 服务器配置
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 8801
RELOAD = True
FACTORY = True
WORKERS = 1
ACCESS_LOG = True

# 文档配置
DEBUG = False
TITLE = "一源AI"
VERSION = "0.1.0"
DESCRIPTION = "一源AI 视频生成服务"
SUMMARY = "接口汇总"

LOGGER_LEVEL = "DEBUG"
LOGGER_INTERCEPT = True
IGNORE_OPERATION_LOG = False

# ================= PostgreSQL / Redis =================
# 【人工配置】
ORM_ENGINE = "postgresql"
POSTGRESQL_HOST = "127.0.0.1"
POSTGRESQL_PORT = 5432
POSTGRESQL_DB_NAME = "grapefruit"
POSTGRESQL_USER = "postgres"
POSTGRESQL_PASSWORD = ""

REDIS_HOST = "127.0.0.1"
REDIS_PORT = 6379
REDIS_DB_NAME = 0
REDIS_USER = "default"
REDIS_PASSWORD = ""

# ================= ARQ 任务队列 =================
ARQ_QUEUE_NAME = "generate"
# 【人工配置】worker 回调本服务所用地址(需 worker 可达;容器内用 http://backend:8801)
BACKEND_PUBLIC_URL = "http://127.0.0.1:8801"
# 需与 worker NOTIFY_TOKEN 一致
WORKER_CALLBACK_SECRET = "dev-callback-secret"   # 需与 worker NOTIFY_TOKEN 一致;prod 必须改为真实值
TASK_STUCK_TIMEOUT = 14400
TASK_RECONCILE_INTERVAL = 300

# ================= 对象存储(腾讯云 COS) =================
OSS_ENABLE = false
# 【人工配置】OSS_ENABLE=true 时必填
OSS_SERVICE_SecretId = ""
OSS_SERVICE_SecretKey = ""
OSS_SERVICE_Bucket = ""
OSS_SERVICE_Region = "ap-chengdu"
OSS_SERVICE_Accelerate = false

# ================= 微信支付(V3) =================
# 模式:mock=模拟支付(仅开发环境) / wechat=真实微信支付
PAYMENT_MODE = "mock"
# 集群来源标识(写入微信 attach,防止多系统回调串单,勿随意修改)
PAYMENT_SOURCE_TAG = "yiyuan"
# 待支付订单超时自动取消(分钟)
PAYMENT_ORDER_EXPIRE_MINUTES = 120
# 支付后允许退款的窗口(天)
PAYMENT_REFUND_WINDOW_DAYS = 7

# 【人工配置】PAYMENT_MODE=wechat 时以下六项必填,在微信支付商户平台获取:
# https://pay.weixin.qq.com → 账户中心/API安全/产品中心
WECHAT_APP_ID = ""            # 公众号/小程序/开放平台的 AppID(与商户号绑定)
WECHAT_MCHID = ""             # 商户号(如 1630000000)
WECHAT_API_V3_KEY = ""        # APIv3 密钥(账户中心 → API安全 → 设置APIv3密钥,32位)
WECHAT_CERT_SERIAL_NO = ""    # 商户API证书序列号(账户中心 → API安全 → API证书)
WECHAT_PRIVATE_KEY = ""       # 商户API私钥文件路径,如 ./certificate/apiclient_key.pem
WECHAT_CERT_DIR = ""          # 微信支付平台证书目录,如 ./certificate/cert/
# 注意:PAYMENT_MODE=wechat 时 BACKEND_PUBLIC_URL 必须是微信可达的公网 HTTPS 域名
# 支付回调:POST {BACKEND_PUBLIC_URL}/api/callback/wxpay/video
# 退款回调:POST {BACKEND_PUBLIC_URL}/api/callback/wxpay/refund
# 依赖:pip install wechatpayv3

# ================= 大模型网关(OpenAI 兼容) =================
# 【人工配置】AI 文案润色等轻量调用;与 worker 可用同一网关
LLM_BASE_API_URL = ""           # 如 https://gateway.example.com/v1
LLM_BASE_API_KEY = ""
# 说明:管理端「系统管理 → 业务配置」中的 gen.chat_model / gen.llm_base_url / gen.llm_api_key
#      优先级高于这里的 env 配置(DB 配置为空才回退 env)

# ================= 短信验证码(腾讯云 SMS) =================
# 渠道:mock=只写日志不发短信(开发自测) / tencent=腾讯云短信
SMS_PROVIDER = "tencent"
# 【人工配置】腾讯云控制台 → 短信 → 应用管理/签名管理/正文模板管理
SMS_SDK_APP_ID = ""           # 短信应用 SDKAppID,如 1400000000
SMS_SIGN_NAME = "一源AI"       # 已审核通过的签名内容(如「一源AI」,无需方括号)
SMS_TEMPLATE_ID = ""          # 正文模板ID,如 1234567(模板内容需含 {1} 作为验证码占位)
SMS_ACCESS_KEY_ID = ""        # 腾讯云 SecretId(访问管理 → 访问密钥 → API密钥管理)
SMS_ACCESS_KEY_SECRET = ""    # 腾讯云 SecretKey
SMS_REGION = "ap-guangzhou"   # 短信服务地域,默认 ap-guangzhou
# 验证码策略
SMS_CODE_EXPIRE = 300         # 有效期(秒)
SMS_CODE_INTERVAL = 60        # 同一手机号重发间隔(秒)
SMS_DAY_LIMIT = 10            # 同一手机号每日发送上限
# ⚠️ 生产必须为 false:true 时接口会把验证码直接返回给前端,任何人都能登录
SMS_DEV_RETURN_CODE = false
# 依赖:pip install tencentcloud-sdk-python-sms

# ================= 腾讯位置服务(LBS,可选) =================
TENCENT_LBS_KEY = ""
TENCENT_LBS_SK = ""
